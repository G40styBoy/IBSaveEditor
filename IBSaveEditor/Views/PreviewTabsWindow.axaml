<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IBSaveEditor.ViewModels.Fields"
        xmlns:fields="using:IBSaveEditor.Views.Fields"
        x:Class="IBSaveEditor.Views.PreviewTabsWindow"
        x:DataType="vm:ManifestTabsViewModel"
        Title="Manifest Preview"
        Width="640" Height="720"
        MinWidth="420" MinHeight="360"
        Background="#0D1B2A"
        FontFamily="'Cascadia Code','Consolas',monospace">

  <!--
    Stand-in window for the manifest tabs, to be deleted once Phase 6 step 5
    lifts this TabControl markup into the real shell (MainWindow).
  -->
  <TabControl Background="#0D1B2A" ItemsSource="{Binding Tabs}">
    <TabControl.ItemTemplate>
      <DataTemplate DataType="vm:TabViewModel">
        <TextBlock Text="{Binding Title}"/>
      </DataTemplate>
    </TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
      <DataTemplate DataType="vm:TabViewModel">
        <ScrollViewer Padding="20">
          <StackPanel Spacing="0">
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SectionViewModel">
                  <fields:SectionView/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Collections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CollectionViewModel">
                  <fields:CollectionView/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DataTemplate>
    </TabControl.ContentTemplate>
  </TabControl>
</Window>
