<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IBSaveEditor.ViewModels.Fields"
             xmlns:fields="using:IBSaveEditor.Views.Fields"
             x:Class="IBSaveEditor.Views.Fields.TabHostView"
             x:DataType="vm:TabHostViewModel">

  <!--
    Phase 3 slice: renders ActiveTab.Sections top to bottom, no tab strip yet.
    Phase 6 adds the strip and game-driven visibility once there's more than
    one tab to switch between.
  -->
  <ScrollViewer Padding="20">
    <StackPanel Spacing="0" DataContext="{Binding ActiveTab}">
      <TextBlock Text="{Binding Title}" Foreground="#E0E1DD" FontSize="20" FontWeight="SemiBold"
                 Margin="0,0,0,4"/>
      <Border BorderBrush="#415A77" BorderThickness="0,0,0,1" Margin="0,0,0,20"/>

      <ItemsControl ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SectionViewModel">
            <fields:SectionView/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Collections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:CollectionViewModel">
            <fields:CollectionView/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
