<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IBSaveEditor.ViewModels"
        xmlns:fieldsvm="using:IBSaveEditor.ViewModels.Fields"
        xmlns:views="using:IBSaveEditor.Views"
        xmlns:fields="using:IBSaveEditor.Views.Fields"
        x:Class="IBSaveEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Height="1000"
        MinWidth="800" MinHeight="520"
        MaxWidth="2000" MaxHeight="1440"
        Background="#0D1B2A">

  <!--
    Implicit (type-keyed) content templates for the shell TabControl below: it binds
    ItemsSource to a heterogeneous list of IShellTab (manifest TabViewModels plus the
    always-present AdvancedTreeViewModel), and TabControl.ContentTemplate can only ever
    be ONE template. Leaving ContentTemplate unset and registering one DataTemplate per
    concrete type here lets Avalonia's content presenter resolve the right one by the
    selected tab's actual runtime type. TabControl.ItemTemplate (set below, on the
    control itself) still governs the header uniformly via the shared IShellTab.Title.
  -->
  <Window.DataTemplates>

    <!-- A manifest tab: its sections, then its collections (owned items, quests, ...) -->
    <DataTemplate DataType="fieldsvm:TabViewModel">
      <ScrollViewer Padding="20">
        <StackPanel Spacing="0">
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="fieldsvm:SectionViewModel">
                <fields:SectionView/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Collections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="fieldsvm:CollectionViewModel">
                <fields:CollectionView/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- The Advanced tab: the raw property tree, unchanged from before the shell swap -->
    <DataTemplate DataType="vm:AdvancedTreeViewModel">
      <Grid ColumnDefinitions="300,1,*">

        <!-- Left: flat property list -->
        <DockPanel Grid.Column="0">
          <Border DockPanel.Dock="Top" Classes="panel-header">
            <DockPanel>
              <TextBlock Classes="panel-label" Text="PROPERTIES" DockPanel.Dock="Left" VerticalAlignment="Center"/>

              <!-- Search bar : filters the property tree as you type. Lives here rather
                   than the global toolbar because it only ever does anything on this tab. -->
              <Border Classes="search-bar" DockPanel.Dock="Right"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Width="180">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Classes="search-icon" Text="🔍"/>
                  <TextBox  Grid.Column="1" Classes="search-input"
                            Text="{Binding SearchText, Mode=TwoWay}"
                            Watermark="Search properties..."/>
                </Grid>
              </Border>
            </DockPanel>
          </Border>

          <!-- Empty state : shown before any file has been loaded -->
          <TextBlock DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}"
                     Text="No file loaded. Click Open in the toolbar to get started."
                     Foreground="#415A77" FontSize="13" TextWrapping="Wrap"
                     Margin="16"/>

          <ListBox x:Name="NodeListBox"
                   Loaded="OnNodeListBoxLoaded"
                   ItemsSource="{Binding VisibleNodes}"
                   SelectedItem="{Binding SelectedNode}"
                   Background="#0D1B2A"
                   BorderThickness="0"
                   Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem" x:DataType="vm:NodeViewModel">
                <Setter Property="Padding"    Value="0"/>
                <Setter Property="Margin"     Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style Selector="^:selected /template/ ContentPresenter">
                  <Setter Property="Background" Value="#1B263B"/>
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter">
                  <Setter Property="Background" Value="#1B263B"/>
                </Style>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:NodeViewModel">
                <views:NodeTreeCell/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Classes="v-divider"/>

        <!-- Right: property editor -->
        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Classes="panel-header">
            <TextBlock Classes="panel-label" Text="EDIT"/>
          </Border>
          <views:PropertyEditorView DataContext="{Binding SelectedNode}"/>
        </DockPanel>

      </Grid>
    </DataTemplate>

  </Window.DataTemplates>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="toolbar" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="toolbar-btn accent" Click="OnOpenClick"  Content="Open"/>
        <Button Classes="toolbar-btn"        Click="OnSaveClick"  Content="Save"/>
        <Button Classes="toolbar-btn"        Click="OnExportClick" Content="Export .bin"/>
        <Border Width="1" Margin="4,0" Background="#415A77"/>
        <Button Classes="toolbar-btn"        Command="{Binding ReloadCommand}" Content="Reload"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <DockPanel>
      <Button Classes="log-clear-btn" DockPanel.Dock="Right"
              Content="About" Click="OnAboutClick"
              Foreground="#08111b" Padding="8,2"
              Background="#778DA9" Margin="0,0,5,5"/>
        <TextBlock Classes="status-text" HorizontalAlignment="Right"
                   IsVisible="{Binding IsDirty}" Foreground="#778DA9"
                   Text="unsaved changes" DockPanel.Dock="Right" Margin="0,0,8,0"/>
        <Border/>
      </DockPanel>
    </Border>

    <!-- Log panel -->
    <Border DockPanel.Dock="Bottom" Classes="log-panel" Height="140">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="log-header">
          <DockPanel>
            <TextBlock Classes="panel-label" Text="LOG" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button Classes="log-clear-btn" HorizontalAlignment="Right"
                    Content="Clear" Click="OnClearLogClick"
                    Foreground="#08111b" Padding="8,2"
                    Background="#778DA9" Margin="0,0,0,0"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="LogScroller"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding LogEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Classes="log-entry" Text="{Binding}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main shell: every manifest tab for the loaded save, plus the always-present Advanced tab -->
    <TabControl Background="#0D1B2A" ItemsSource="{Binding ShellTabs}"
                SelectedItem="{Binding SelectedShellTab}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="vm:IShellTab">
          <TextBlock Text="{Binding Title}"/>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>

  </DockPanel>
</Window>
